# ---------- database ----------
DATABASE_URL="postgresql://ehsan:ehsan_dev@localhost:5432/ehsan_admin?schema=public"

# ---------- server ----------
PORT=4000
NODE_ENV=development
SESSION_SECRET="change-me-to-32-plus-random-bytes-in-any-real-deployment"
PUBLIC_SITE_URL="http://localhost:5500"

# ---------- content bridge ----------
# Where the panel writes data/*.json for the existing static site to consume.
SITE_DATA_DIR="../data"

# ---------- AI ----------
# Swap providers with this one line. Nothing else changes.
AI_PROVIDER=openrouter          # openrouter | anthropic | none

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemma-4-31b-it:free"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
