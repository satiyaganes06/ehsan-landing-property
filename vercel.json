{
  "functions": {"api/company-facts.mjs": {"includeFiles": "ai-instructions/index.html"}},
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}
    ]}
  ],
  "redirects": [
    {"source":"/index.html","destination":"/","permanent":true},
    {"source":"/html/about.html","destination":"/about","permanent":true},
    {"source":"/html/projects.html","destination":"/projects","permanent":true},
    {"source":"/html/events.html","destination":"/events","permanent":true},
    {"source":"/html/news.html","destination":"/news","permanent":true}
  ],
  "rewrites": [
    {"source":"/ai-instructions","destination":"/api/company-facts"},
    {"source":"/about","destination":"/html/about.html"},
    {"source":"/projects","destination":"/html/projects.html"},
    {"source":"/events","destination":"/html/events.html"},
    {"source":"/news","destination":"/html/news.html"},
    {"source":"/projects/:slug","destination":"/html/project-detail.html"},
    {"source":"/events/:slug","destination":"/html/event-detail.html"},
    {"source":"/news/:slug","destination":"/html/news-detail.html"}
  ]
}
