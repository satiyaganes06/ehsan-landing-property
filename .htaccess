Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
RewriteEngine On
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:ehsan-property-admin|app|api/company-facts\.mjs|docs|scripts|tools)(?:/|$) - [F,L,NC]
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+html/(about|projects|events|news)\.html[?\s] [NC]
RewriteRule ^html/(about|projects|events|news)\.html$ /$1 [R=301,L]
RewriteRule ^(about|projects|events|news)/$ /$1 [R=301,L]
RewriteRule ^(about|projects|events|news)$ html/$1.html [L]
RewriteCond %{DOCUMENT_ROOT}/$1/$2/index.html -f
RewriteRule ^(projects|events|news)/([a-z0-9-]+)/?$ $1/$2/index.html [L]
RewriteRule ^projects/[a-z0-9-]+/?$ html/project-detail.html [L]
RewriteRule ^events/[a-z0-9-]+/?$ html/event-detail.html [L]
RewriteRule ^news/[a-z0-9-]+/?$ html/news-detail.html [L]
